# Browser-safe Supabase configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase configuration
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional client analytics (disabled until configured and consented)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Optional error monitoring
VITE_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN is required only at build time for source-map upload.

# External billing remains Sandbox-only
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
APP_URL=
INTERNAL_CRON_SECRET=
