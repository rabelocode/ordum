SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy name supported for existing deployments:
# VITE_SUPABASE_ANON_KEY=
# Existing Vercel aliases are also supported:
# VITE_PUBLIC_SUPABASE_URL=
# VITE_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Public application origin used in invitation links.
APP_URL=http://localhost:3000

# Billing is intentionally disabled until Asaas Sandbox homologation.
BILLING_ENABLED=false
BILLING_PROVIDER=asaas
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
ASAAS_USER_AGENT=Ordum
ASAAS_WEBHOOK_URL=

# Generated by Vercel for authenticated Cron requests. Never expose to Vite.
CRON_SECRET=
